 ],
 "poems": [
  {
   "seq": "1",
   "text": "あら玉の年もかはらて古〓の雪のうちにも春は來にけり",
   "kana": "",
   "speaker": "",
   "page": 554,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "2",
   "text": "冬なから花散そらのかすめるは雲のこなたに春やきぬらん",
   "kana": "",
   "speaker": "",
   "page": 554,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "3",
   "text": "今日もなを雪は降つゝ春霞立るやいつこ若なつみてむ",
   "kana": "",
   "speaker": "",
   "page": 554,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "4",
   "text": "朝氷たかため分て此河のむかひの野へに若菜つむらん",
   "kana": "",
   "speaker": "",
   "page": 554,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "5",
   "text": "谷川のうち出る波も聲たてつ鶯さそへ春の山風",
   "kana": "",
   "speaker": "",
   "page": 554,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "6",
   "text": "春に今あふ坂山のいはし水木かくれ出る鶯のこゑ",
   "kana": "",
   "speaker": "",
   "page": 554,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "7",
   "text": "おほかたの空のけしきはかすめとも月影さゆる春のよの霜",
   "kana": "",
   "speaker": "",
   "page": 554,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "8",
   "text": "はし姫の霞の衣ぬきをうすみまたさむしろの宇治の山風",
   "kana": "",
   "speaker": "",
   "page": 554,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "9",
   "text": "梅がゝにむかしをとへは春の月こたへぬ影そ袖にうつれる",
   "kana": "",
   "speaker": "",
   "page": 554,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "10",
   "text": "幾里か月のひかりも匂ふらん梅さく山の峯の春風",
   "kana": "",
   "speaker": "",
   "page": 554,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "11",
   "text": "住人もうつれはかはる古〓のむかしに匂ふ窓の梅かえ",
   "kana": "",
   "speaker": "",
   "page": 554,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "12",
   "text": "おもふとちそこともしらす行暮ぬ花のやとかせ野への鶯",
   "kana": "",
   "speaker": "",
   "page": 554,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "13",
   "text": "朝ほらけとふ火かくれの生駒山それともみえす春の霞に",
   "kana": "",
   "speaker": "",
   "page": 554,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "14",
   "text": "志賀の浦やしらゆふ花の浪の上に霞を分て春風そ吹",
   "kana": "",
   "speaker": "",
   "page": 554,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "15",
   "text": "霞たつ末の松山ほの〓〓と浪にはなるゝ橫雲のそら",
   "kana": "",
   "speaker": "",
   "page": 554,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "16",
   "text": "ときしあれは櫻とそ思ふ春風の吹上の演に立る白波",
   "kana": "",
   "speaker": "",
   "page": 554,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "17",
   "text": "此ほとはおられぬ雲そかゝるらんたつれもゆかし山の櫻木",
   "kana": "",
   "speaker": "",
   "page": 554,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "18",
   "text": "人傳に咲とはきかし櫻花よし野の山に日數こゆとも",
   "kana": "",
   "speaker": "",
   "page": 554,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "19",
   "text": "歸る雁秋こし數はしらねとも寢覺の空に聲そすくなき",
   "kana": "",
   "speaker": "",
   "page": 554,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "20",
   "text": "なかむれは曇るともなき春のよの月にかすみて歸る膓かね",
   "kana": "",
   "speaker": "",
   "page": 554,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "21",
   "text": "うつしうふる齡は老ぬ八重櫻しらぬ命の春そ稀なる",
   "kana": "",
   "speaker": "",
   "page": 554,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "22",
   "text": "さくら花咲ぬる時は葛城の山のすかたにかゝる白雲",
   "kana": "",
   "speaker": "",
   "page": 554,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "23",
   "text": "櫻色の霞のま袖露をおもみうらみぬ山そ宿の明ほの",
   "kana": "",
   "speaker": "",
   "page": 554,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "24",
   "text": "あけ置し山櫻戶もとちてけりをのれ雲なる春のさかりは",
   "kana": "",
   "speaker": "",
   "page": 554,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "25",
   "text": "この程はしるもしらぬも玉鉾の行かふ袖は花の香そする",
   "kana": "",
   "speaker": "",
   "page": 554,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "26",
   "text": "泊瀨山うつろはんとや櫻花色かはり行峯のしら雲",
   "kana": "",
   "speaker": "",
   "page": 554,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "27",
   "text": "さくら花夢かうつゝかしら雲のたえてつれなき峯の春風",
   "kana": "",
   "speaker": "",
   "page": 554,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "28",
   "text": "櫻花おもふもつらし風の上にありかさためぬちりのまかひは",
   "kana": "",
   "speaker": "",
   "page": 554,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "29",
   "text": "今朝みれは初瀨の檜はら雪白し峯の櫻に嵐吹らし",
   "kana": "",
   "speaker": "",
   "page": 554,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "30",
   "text": "さくら狩かた野の雑子妻こひて鳴やうつらふ花の下草",
   "kana": "",
   "speaker": "",
   "page": 554,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "31",
   "text": "吉野川岸の山吹咲にけり峯のさくらは散はてぬらん",
   "kana": "",
   "speaker": "",
   "page": 555,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "32",
   "text": "暮て行やよひの空をなかむれは霞にまかふ有明の月",
   "kana": "",
   "speaker": "",
   "page": 555,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "33",
   "text": "昨日かも濡つゝ折し花の色にけふさへしゐて村雨そふる",
   "kana": "",
   "speaker": "",
   "page": 555,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "34",
   "text": "夏衣春にをくれてさく花のかをたに匂へをなしかたみに",
   "kana": "",
   "speaker": "",
   "page": 555,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "35",
   "text": "郭公まつとせしまに我宿の池の藤なみうつろひにけり",
   "kana": "",
   "speaker": "",
   "page": 555,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "36",
   "text": "いかにせんこぬ夜あまたの郭公またしとおもへは村雨のそら",
   "kana": "",
   "speaker": "",
   "page": 555,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "37",
   "text": "五月雨の雲のあなたはいたつらに人もなかめぬ月やすむらん",
   "kana": "",
   "speaker": "",
   "page": 555,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "38",
   "text": "むは玉のやみのうつゝの鵜飼舟月のさかりや夢もみゆへき",
   "kana": "",
   "speaker": "",
   "page": 555,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "39",
   "text": "短夜のまたふしなれぬ芦のやのつまもあらはに明るしのゝめ",
   "kana": "",
   "speaker": "",
   "page": 555,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "40",
   "text": "あかなくにやすらへ空の子規夏くはゝれる年もまれ也",
   "kana": "",
   "speaker": "",
   "page": 555,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "41",
   "text": "おもひあれやたか白妙の夏衣日も夕かほの花の下草",
   "kana": "",
   "speaker": "",
   "page": 555,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "42",
   "text": "松むしもまた音つれぬ淺茅生に野中の杜の日くらしの聲",
   "kana": "",
   "speaker": "",
   "page": 555,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "43",
   "text": "夏引の糸もてをれる永き日のみもすそ川は千代もすむらん",
   "kana": "",
   "speaker": "",
   "page": 555,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "44",
   "text": "御秡する八十氏人の夏衣河かせすゝし秋や立なん",
   "kana": "",
   "speaker": "",
   "page": 555,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "45",
   "text": "昨日たにとはんと思ひし津の國の生田の杜に秋はきにけり",
   "kana": "",
   "speaker": "",
   "page": 555,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "46",
   "text": "明ぬなり衣手さむし菅原や伏見の里の秋の初風",
   "kana": "",
   "speaker": "",
   "page": 555,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "47",
   "text": "玉ほこの道もやとりもしら露に吹しくをのゝ篠原",
   "kana": "",
   "speaker": "",
   "page": 555,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "48",
   "text": "をとめ子か袖ふる山の玉かつらみたれてなひく秋の白露",
   "kana": "",
   "speaker": "",
   "page": 555,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "49",
   "text": "袖の色もひとつに成ぬ萩原や遠かた人とよそにたにみし",
   "kana": "",
   "speaker": "",
   "page": 555,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "50",
   "text": "啼わたる鴈の涙をこきませて本あらの萩に秋風そ吹",
   "kana": "",
   "speaker": "",
   "page": 555,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "51",
   "text": "花すゝきほむけの糸のかたよりにくるれは野へに秋風そふく",
   "kana": "",
   "speaker": "",
   "page": 555,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "52",
   "text": "月〓み有明の霜の萩か枝に白きをみれは嵐なりけり",
   "kana": "",
   "speaker": "",
   "page": 555,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "53",
   "text": "秋風はさてもや物のかなしきと荻の葉ならぬ夕暮も哉",
   "kana": "",
   "speaker": "",
   "page": 555,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "54",
   "text": "のき近き山のした荻に聲立て夕日かくれに秋風そ吹",
   "kana": "",
   "speaker": "",
   "page": 555,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "55",
   "text": "かへる山いつはた秋と思ひこし雲ゐの鴈も今やあひみん",
   "kana": "",
   "speaker": "",
   "page": 555,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "56",
   "text": "秋の夜は窓うつ雨に明やらて雲ゐに鴈の聲そ過ぬる",
   "kana": "",
   "speaker": "",
   "page": 555,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "57",
   "text": "妻かくす矢野の神山立まよひゆふへの霧に鹿や啼蘭",
   "kana": "",
   "speaker": "",
   "page": 555,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "58",
   "text": "須磨の浦に秋やくあまの初鹽の烟に霧の色はそめゆく",
   "kana": "",
   "speaker": "",
   "page": 555,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "59",
   "text": "くれぬまに山のは遠く成にけり空より出る秋のよの月",
   "kana": "",
   "speaker": "",
   "page": 555,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "60",
   "text": "さらしなやをは捨山の高根よりあらしを分て出る月かけ",
   "kana": "",
   "speaker": "",
   "page": 555,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "61",
   "text": "なかめつゝ思ふもさひし久かたの月のみやこの明かたの空",
   "kana": "",
   "speaker": "",
   "page": 555,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "62",
   "text": "限あれは明なむとする鐘のをとになを長き夜の月そ殘れる",
   "kana": "",
   "speaker": "",
   "page": 555,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "63",
   "text": "すまの蜑のまとをの衣夜やさむき浦風なから月もたまらす",
   "kana": "",
   "speaker": "",
   "page": 555,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "64",
   "text": "鳩の海や月の光もうつろへは浪の花にも秋は見えけり",
   "kana": "",
   "speaker": "",
   "page": 555,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "65",
   "text": "をとめ子か玉ものすそにみつしほの光をよする浦の月かけ",
   "kana": "",
   "speaker": "",
   "page": 555,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "66",
   "text": "しら雲はよそにもみえす葛城やたかまの月に嵐吹らし",
   "kana": "",
   "speaker": "",
   "page": 555,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "67",
   "text": "深草や竹の葉山の夕きりに人こそ見えね鶉鳴也",
   "kana": "",
   "speaker": "",
   "page": 555,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "68",
   "text": "はし鷹のはつかり衣露わけて野草の萩の色そうつろふ",
   "kana": "",
   "speaker": "",
   "page": 555,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "69",
   "text": "忍ひわひて小のゝしの原をく露にあまりてたれを松虫の聲",
   "kana": "",
   "speaker": "",
   "page": 555,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "70",
   "text": "有明のつれなくみえし淺茅生にをのれも名のみ松むしの聲",
   "kana": "",
   "speaker": "",
   "page": 555,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "71",
   "text": "むしの音もなかき夜あかぬ古〓に猶思ひそふ松風そ吹",
   "kana": "",
   "speaker": "",
   "page": 555,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "72",
   "text": "山里ははた織虫のかた糸のよるさへやすくねられさりけり",
   "kana": "",
   "speaker": "",
   "page": 556,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "73",
   "text": "川上のゆつはの村のうす紅葉した草かけて露や染らん",
   "kana": "",
   "speaker": "",
   "page": 556,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "74",
   "text": "下紅葉かつ散山の夕しくれぬれてやひとり鹿の鳴らん",
   "kana": "",
   "speaker": "",
   "page": 556,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "75",
   "text": "をくら山西こそ秋と尋ぬれは入日にまかふ岑のもみちは",
   "kana": "",
   "speaker": "",
   "page": 556,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "76",
   "text": "色かはる今や木の葉のうへにをく霜といふへのかつらきの山",
   "kana": "",
   "speaker": "",
   "page": 556,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "77",
   "text": "手向山紅葉のにしきぬさはあれと猶月影のかくるしらゆふ",
   "kana": "",
   "speaker": "",
   "page": 556,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "78",
   "text": "いつるより心もつきす木からしの下吹はらふ山のはの月",
   "kana": "",
   "speaker": "",
   "page": 556,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "79",
   "text": "月影もすめはすみけり白雲のたえすたなひく峯のこからし",
   "kana": "",
   "speaker": "",
   "page": 556,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "80",
   "text": "さえ渡る光を霜にまかへてや月にうつろふしら菊の花",
   "kana": "",
   "speaker": "",
   "page": 556,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "81",
   "text": "長月の十日あまりのみかの原河なみ〓くすめる月かけ",
   "kana": "",
   "speaker": "",
   "page": 556,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "82",
   "text": "秋ふくる月の光に夜やさむき衣うつなりさらしなの里",
   "kana": "",
   "speaker": "",
   "page": 556,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "83",
   "text": "世にふれは賤のをた卷はては又月にいくたひ衣うつらん",
   "kana": "",
   "speaker": "",
   "page": 556,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "84",
   "text": "古〓や冬はあすかの河風にいたつらならすうつ衣哉",
   "kana": "",
   "speaker": "",
   "page": 556,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "85",
   "text": "露しくれもる山かけの下紅葉ぬるともおらむ秋のかたみに",
   "kana": "",
   "speaker": "",
   "page": 556,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "86",
   "text": "月かけの露のやとりになにしきてわかれにたへぬ秋の空哉",
   "kana": "",
   "speaker": "",
   "page": 556,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "87",
   "text": "もみち葉を萩の錦に敷かへて今は時雨の山田もる庵",
   "kana": "",
   "speaker": "",
   "page": 556,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "88",
   "text": "露霜とうつろふ袖もくちぬへし篠わくるのゝ冬のかよひち",
   "kana": "",
   "speaker": "",
   "page": 556,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "89",
   "text": "なかめつゝ幾度袖に曇るらん時雨にふくる有明の月",
   "kana": "",
   "speaker": "",
   "page": 556,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "90",
   "text": "鵲のわたすやいつこ夕霜の雲ゐにしろき峯の梯",
   "kana": "",
   "speaker": "",
   "page": 556,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "91",
   "text": "みそれふるは山が下のをそ紅葉一むら見ゆる冬の夕暮",
   "kana": "",
   "speaker": "",
   "page": 556,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "92",
   "text": "立田川もみち葉とつるうす氷わたらはそれも中や絕なん",
   "kana": "",
   "speaker": "",
   "page": 556,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "93",
   "text": "故里の庭の日かけもさえくれて桐の落葉に霰ふる也",
   "kana": "",
   "speaker": "",
   "page": 556,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "94",
   "text": "夕つく日さすかにうつる柴の戶に霰吹まく山颪のかせ",
   "kana": "",
   "speaker": "",
   "page": 556,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "95",
   "text": "あしへ行鴨のはかひの夕霜をよそにはなかぬさよ千鳥哉",
   "kana": "",
   "speaker": "",
   "page": 556,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "96",
   "text": "まつ人のゆきゝの岡もしら雪のあすさへふらは跡や絕なん",
   "kana": "",
   "speaker": "",
   "page": 556,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "97",
   "text": "草の原出にし人は音もせてあらぬ外山の松の雪折",
   "kana": "",
   "speaker": "",
   "page": 556,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "98",
   "text": "和田のはら八十島しろく降雪のあまきろ浪にまかふ釣船",
   "kana": "",
   "speaker": "",
   "page": 556,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "99",
   "text": "みよし野の藤の下葉のかれしよりは山もみ雪ふらぬ日はなし",
   "kana": "",
   "speaker": "",
   "page": 556,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "100",
   "text": "明わたる雲まの星の光まて山のは寒し峯の白雪",
   "kana": "",
   "speaker": "",
   "page": 556,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "101",
   "text": "しかの浦や遠さかり行浪まより氷て出る有明の月",
   "kana": "",
   "speaker": "",
   "page": 556,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "102",
   "text": "さしのほるこしのしられの冬の月雪は氷の麓なりけり",
   "kana": "",
   "speaker": "",
   "page": 556,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "103",
   "text": "谷川の音は此ほとたえはてゝ氷に殘る峯の松風",
   "kana": "",
   "speaker": "",
   "page": 556,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "104",
   "text": "たか島やみほの柚山跡たえてこほりし雪も深き冬かな",
   "kana": "",
   "speaker": "",
   "page": 556,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "105",
   "text": "けぬかうへに降しけみ雪白川の關のこなたに春もこそたて",
   "kana": "",
   "speaker": "",
   "page": 556,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "106",
   "text": "雪のうちにつゐにもみちぬ松の葉のつれなき山も暮る年かな",
   "kana": "",
   "speaker": "",
   "page": 556,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "107",
   "text": "とりとむる物とはなしに行雲の〓としもはやく暮る空かな",
   "kana": "",
   "speaker": "",
   "page": 556,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "108",
   "text": "むかふへき春の名殘の末のかけ身にあらたまの年もすくなし",
   "kana": "",
   "speaker": "",
   "page": 556,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "109",
   "text": "いたつらに人はしらてや暮すらんけふこそ我を思ひそむとも",
   "kana": "",
   "speaker": "",
   "page": 556,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "110",
   "text": "しらすへき煙も雲にうつもれぬあさまのたけの夕くれの空",
   "kana": "",
   "speaker": "",
   "page": 556,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "111",
   "text": "白浪の入江にまがふ初草のはつかにみえし人そ悲しき",
   "kana": "",
   "speaker": "",
   "page": 556,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "112",
   "text": "我袖は色に出ぬへしかくれぬの初瀨の山も打時雨つゝ",
   "kana": "",
   "speaker": "",
   "page": 556,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "113",
   "text": "是も又いかなるえにか契りけんつゝむほたるの袖にうきぬる",
   "kana": "",
   "speaker": "",
   "page": 556,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "114",
   "text": "いかにせん深山かくれの秋の草しけさまされは露そ置そふ",
   "kana": "",
   "speaker": "",
   "page": 557,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "115",
   "text": "山河に風のかけたるしからみの色に出てもめるゝ袖かな",
   "kana": "",
   "speaker": "",
   "page": 557,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "116",
   "text": "よし野川岩とかしはのをのれのみつれなき色も波はかけつゝ",
   "kana": "",
   "speaker": "",
   "page": 557,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "117",
   "text": "葛城や高まの山にさすしめのよそにのみやは戀んと思ひし",
   "kana": "",
   "speaker": "",
   "page": 557,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "118",
   "text": "契置し千木のかたそきむなしくは行合のまの霜と消なむ",
   "kana": "",
   "speaker": "",
   "page": 557,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "119",
   "text": "時過てをのゝ淺茅に立けふりしりぬや今も思ひ有とは",
   "kana": "",
   "speaker": "",
   "page": 557,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "120",
   "text": "長きねのすがのあら野にかる草のゆふてもたゆくとれぬ君哉",
   "kana": "",
   "speaker": "",
   "page": 557,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "121",
   "text": "よそにたにみぬめの浦にすむ蜑の袖にたまらぬ玉やひろはん",
   "kana": "",
   "speaker": "",
   "page": 557,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "122",
   "text": "海人のすむ里のしるへに立けふり〓と浦風に誰なひくらん",
   "kana": "",
   "speaker": "",
   "page": 557,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "123",
   "text": "思ひ川みをはやなから水のあはの消てもあはん浪のまも哉",
   "kana": "",
   "speaker": "",
   "page": 557,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "124",
   "text": "東路のさのゝ船はしさのみやはつらき心をかけて賴ん",
   "kana": "",
   "speaker": "",
   "page": 557,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "125",
   "text": "なかめてもうらみぬ袖はいかならん雲路の浪にあくる月影",
   "kana": "",
   "speaker": "",
   "page": 557,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "126",
   "text": "おもひかね積れはおふる月をみてつれなき人に年はへにけり",
   "kana": "",
   "speaker": "",
   "page": 557,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "127",
   "text": "たれか世につれなき種をまきもくの檜原の山の色もかはらす",
   "kana": "",
   "speaker": "",
   "page": 557,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "128",
   "text": "床はあれぬいたくな吹そ秋風のめにみぬ人を夢にたに見ん",
   "kana": "",
   "speaker": "",
   "page": 557,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "129",
   "text": "山川の紅葉にましる水のあはの色に出ても消やわたらん",
   "kana": "",
   "speaker": "",
   "page": 557,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "130",
   "text": "おきて行袖のみぬれてあさかしはぬるや川邊の夢にたに見す",
   "kana": "",
   "speaker": "",
   "page": 557,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "131",
   "text": "くもれけふ入あひの鐘もほと遠したのめて歸る春の曙",
   "kana": "",
   "speaker": "",
   "page": 557,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "132",
   "text": "今はたゝ待しと思ふよひ〓〓のふくるもつらき鐘の音哉",
   "kana": "",
   "speaker": "",
   "page": 557,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "133",
   "text": "夕暮のわか魂はおもひやる袖の中にやいりなやむらん",
   "kana": "",
   "speaker": "",
   "page": 557,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "134",
   "text": "あふとみて〓とそともなく明にけりはかなの夢の忘れかたみや",
   "kana": "",
   "speaker": "",
   "page": 557,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "135",
   "text": "つくは山やまもあせねと吹風に人の心のひまそつれなき",
   "kana": "",
   "speaker": "",
   "page": 557,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "136",
   "text": "おもひかねなかむれは又夕日さす軒はの山の松もうらめし",
   "kana": "",
   "speaker": "",
   "page": 557,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "137",
   "text": "千はや振神の三室のます鏡かけて幾代のかけを戀らん",
   "kana": "",
   "speaker": "",
   "page": 557,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "138",
   "text": "大方のくるゝまつまも定めなきたまのをよはみ戀つゝそふる",
   "kana": "",
   "speaker": "",
   "page": 557,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "139",
   "text": "人こゝろあら磯なみにおりかねてよそにやねなん伊勢の濵荻",
   "kana": "",
   "speaker": "",
   "page": 557,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "140",
   "text": "しく涙ひとりやねなん袖のうちさはく湊はよる船もなし",
   "kana": "",
   "speaker": "",
   "page": 557,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "141",
   "text": "もろこしもちかの浦半の夜の夢思はぬ中そ遠つ舟人",
   "kana": "",
   "speaker": "",
   "page": 557,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "142",
   "text": "心から我身こす浪うきしつみうらみてそふる八重の鹽風",
   "kana": "",
   "speaker": "",
   "page": 557,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "143",
   "text": "伊勢の海の蜑のまてかたまてしはし恨に浪のひまはなくとも",
   "kana": "",
   "speaker": "",
   "page": 557,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "144",
   "text": "うちわたす演名の橋の入しほにたなゝし小船誰がこふらん",
   "kana": "",
   "speaker": "",
   "page": 557,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "145",
   "text": "おもひいる身は深草の秋の露たのめし末や木枯の風",
   "kana": "",
   "speaker": "",
   "page": 557,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "146",
   "text": "菅はらや伏見の里のあれまくらゆふかひもなき草の霜哉",
   "kana": "",
   "speaker": "",
   "page": 557,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "147",
   "text": "風吹は峯にわかるゝ雲をたに有し名殘のかたみとも見よ",
   "kana": "",
   "speaker": "",
   "page": 557,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "148",
   "text": "富士の根の烟もなをそ立のほるうへなき物は思ひなりけり",
   "kana": "",
   "speaker": "",
   "page": 557,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "149",
   "text": "わするなよ今はの心かはるともなれし其夜の有明の月",
   "kana": "",
   "speaker": "",
   "page": 557,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "150",
   "text": "何となく我ゆへぬれし袖の上にあさかりけりと月やみるらん",
   "kana": "",
   "speaker": "",
   "page": 557,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "151",
   "text": "岩の上に波こすあへの島つ鳥うき名に濡て戀つゝそふる",
   "kana": "",
   "speaker": "",
   "page": 557,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "152",
   "text": "池にすむをし明かたの空の月袖の氷になく〓〓そみる",
   "kana": "",
   "speaker": "",
   "page": 557,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "153",
   "text": "さめやする今やとみえし秋の夜の夢路かたしくさよの手枕",
   "kana": "",
   "speaker": "",
   "page": 557,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "154",
   "text": "逢事はぬるをたのみの夢路にてをたえの橋に月そ深行",
   "kana": "",
   "speaker": "",
   "page": 557,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "155",
   "text": "思ひ川かけみし水のうす氷かさなるよはの月もうらめし",
   "kana": "",
   "speaker": "",
   "page": 558,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "156",
   "text": "音にのみきくのはま松下葉さへうつろふ頃の人はたのまし",
   "kana": "",
   "speaker": "",
   "page": 558,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "157",
   "text": "たゝたのめ時雨も露もをく霜のあはての杜の秋の夕くれ",
   "kana": "",
   "speaker": "",
   "page": 558,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "158",
   "text": "まてとやはこゝにたのめし鶉なくいは田の小のゝ秋の夕暮",
   "kana": "",
   "speaker": "",
   "page": 558,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "159",
   "text": "今こむとたのめてとはぬ秋のよの明るもしらぬ松虫のこゑ",
   "kana": "",
   "speaker": "",
   "page": 558,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "160",
   "text": "さても猶とはれぬ秋のゆふは山雲吹風も峯にみゆらん",
   "kana": "",
   "speaker": "",
   "page": 558,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "161",
   "text": "有乳山矢田のゝあさち色つきぬ人の心の峯の淡雪",
   "kana": "",
   "speaker": "",
   "page": 558,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "162",
   "text": "しらさりきこしの菅原あれはてゝ折にもあはぬ思ひ有とも",
   "kana": "",
   "speaker": "",
   "page": 558,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "163",
   "text": "霜かるゝ人の心のあさは野に立みは小菅根さへくちめや",
   "kana": "",
   "speaker": "",
   "page": 558,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "164",
   "text": "さりともと待こし物をあら玉のとしの三とせの冬の夕暮",
   "kana": "",
   "speaker": "",
   "page": 558,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "165",
   "text": "思ひ出よ誰かね〓との末ならん昨日の雲のあとの山風",
   "kana": "",
   "speaker": "",
   "page": 558,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "166",
   "text": "人心何につなかむ色かはる正木のつなのよるもたまらす",
   "kana": "",
   "speaker": "",
   "page": 558,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "167",
   "text": "もろこしの空もひとつに雲消てたれかみかさの山のはの月",
   "kana": "",
   "speaker": "",
   "page": 558,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "168",
   "text": "濵松のこすゑの風に年ふりて月にさひたる鶴の一聲",
   "kana": "",
   "speaker": "",
   "page": 558,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "169",
   "text": "紅葉はにうつもれてこそ立田河ふるきみゆきの跡は見えけり",
   "kana": "",
   "speaker": "",
   "page": 558,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "170",
   "text": "さゝ浪やおほつの宮のみや木守しらすみし夜の空の月影",
   "kana": "",
   "speaker": "",
   "page": 558,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "171",
   "text": "瀧の音松のあらしも馴ぬれはうちぬるほとの夢は見せけり",
   "kana": "",
   "speaker": "",
   "page": 558,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "172",
   "text": "その山と契らぬ月も秋風もすゝむる袖に露こほれつゝ",
   "kana": "",
   "speaker": "",
   "page": 558,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "173",
   "text": "古〓に聞し嵐の聲もにす忘れぬ人をさやの中山",
   "kana": "",
   "speaker": "",
   "page": 558,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "174",
   "text": "旅ねする夢路はゆるせうつの山關とはきかす守人もなし",
   "kana": "",
   "speaker": "",
   "page": 558,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "175",
   "text": "野邊の露浦半の波をかこちても行衞もしらぬ袖の月かけ",
   "kana": "",
   "speaker": "",
   "page": 558,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "176",
   "text": "月もよし氷ふみわけ玉しまの此河上に宿はたつねん",
   "kana": "",
   "speaker": "",
   "page": 558,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "177",
   "text": "たかしまやかちのゝ原に宿とへはけふやはゆかん遠の白雲",
   "kana": "",
   "speaker": "",
   "page": 558,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "178",
   "text": "たゝくれぬ關の戶さゝぬ比なれは月にも越んあしからの山",
   "kana": "",
   "speaker": "",
   "page": 558,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "179",
   "text": "あけは又こゆへき山の峯なれや空行月の末の白雲",
   "kana": "",
   "speaker": "",
   "page": 558,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "180",
   "text": "秋風の袖に吹まく峯の雲を翅にかけて膓もなく也",
   "kana": "",
   "speaker": "",
   "page": 558,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "181",
   "text": "さえくらすさやの中山なか〓〓にこれより冬の奥もまさらし",
   "kana": "",
   "speaker": "",
   "page": 558,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "182",
   "text": "もみちする雲の林も時雨なり我そわひ人たのむかけなし",
   "kana": "",
   "speaker": "",
   "page": 558,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "183",
   "text": "春日山谷のむもれ木くらぬとも君につけこせ峯の松風",
   "kana": "",
   "speaker": "",
   "page": 558,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "184",
   "text": "春日山おとろの道も中たえぬ身をうちはしの秋の夕暮",
   "kana": "",
   "speaker": "",
   "page": 558,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "185",
   "text": "いつかわれ苔の袂に露をきてしらぬ山ちの月をみるへき",
   "kana": "",
   "speaker": "",
   "page": 558,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "186",
   "text": "高砂の尾上の松の夕しくれかくてふり行身をやつくさん",
   "kana": "",
   "speaker": "",
   "page": 558,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "187",
   "text": "かなしざの昨日の夢にくらふれはうつろふ花もけふの山風",
   "kana": "",
   "speaker": "",
   "page": 558,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "188",
   "text": "和歌の浦や立うは浪の跡をたちおきをふかめて見し人そなき",
   "kana": "",
   "speaker": "",
   "page": 558,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "189",
   "text": "玉きはる命は誰もなきものを忘れぬ心思ひか",
   "kana": "",
   "speaker": "",
   "page": 558,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "190",
   "text": "きのふ見し跡なき山のあとゝては入相の鐘に雲そかゝりし",
   "kana": "",
   "speaker": "",
   "page": 558,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "191",
   "text": "なさけ有此頃の世の數に入てうき身のはても人や忍はん",
   "kana": "",
   "speaker": "",
   "page": 558,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "192",
   "text": "うきなからみし世は猶も忍れて聞は戀しきむかし也けり",
   "kana": "",
   "speaker": "",
   "page": 558,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "193",
   "text": "おもふかた山は富士のね年をへて我身の雪そふりまさり行",
   "kana": "",
   "speaker": "",
   "page": 558,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "194",
   "text": "今日もうし昨日もつらし飛鳥河みのいたつらに月日かそへて",
   "kana": "",
   "speaker": "",
   "page": 558,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "195",
   "text": "和哥の浦や沖つ汐あひにうかひ出る哀我身のよるへしらせよ",
   "kana": "",
   "speaker": "",
   "page": 558,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "196",
   "text": "君か代にあふくま川の埋木も氷の下に春をまちけり",
   "kana": "",
   "speaker": "",
   "page": 558,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "197",
   "text": "おもひきや御世のはしめの秋の霜ふりて雲ゐの月をみんとは",
   "kana": "",
   "speaker": "",
   "page": 559,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "198",
   "text": "おほかたの秋のねさめの長き夜も君をそ祈る身を思ふとて",
   "kana": "",
   "speaker": "",
   "page": 559,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "199",
   "text": "なかきよの月のみゆきの影なれは雲ゐの竹の末もたはます",
   "kana": "",
   "speaker": "",
   "page": 559,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "200",
   "text": "君か代の干とせも秋そあらはるゝ四方の時雨にのこる松か枝",
   "kana": "",
   "speaker": "",
   "page": 559,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  }
 ],
